{
  "name": "contact-list",
  "version": "0.0.1",
  "description": "Simple contact management app",
  "author": "Isah Ohieku",
  "private": true,
  "license": "UNLICENSED",
  "keywords": [
    "nestjs",
    "contact-management",
    "typescript",
    "typeorm"
  ],
  "homepage": "https://github.com/your-username/contact-list#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/contact-list.git"
  },
  "bugs": {
    "url": "https://github.com/your-username/contact-list/issues"
  },
  "main": "dist/main.js",
  "scripts": {
    "pretypeorm": "ts-node -r tsconfig-paths/register ./src/database/scripts/typeorm-config.ts",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d ./src/database/data-source.ts",
    "migration:generate": "yarn typeorm migration:generate",
    "migration:create": "yarn typeorm migration:create",
    "migration:run": "yarn typeorm migration:run",
    "migration:revert": "yarn typeorm migration:revert",
    "schema:drop": "yarn typeorm schema:drop",
    "schema:sync": "yarn typeorm schema:sync",
    "db:seed": "ts-node -r tsconfig-paths/register ./src/database/seeds/run-seeds.ts",
    "seed:run": "ts-node -r tsconfig-paths/register ./src/database/seeds/run-seeds.ts",
    "db:reset": "yarn schema:drop && yarn migration:run && yarn db:seed",
    "prebuild": "rimraf dist",
    "build": "nest build",
    "build:prod": "nest build --webpack",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "start:hmr": "nest start --watch --preserveWatchOutput",
    "lint": "eslint \"{src,test}/**/*.ts\" --max-warnings 0",
    "lint:fix": "eslint \"{src,test}/**/*.ts\" --fix",
    "prettier": "prettier \"./**/*.{ts,tsx,js,json,md}\"",
    "prettier:fix": "prettier --write \"./**/*.{ts,tsx,js,json,md}\"",
    "prettier:check": "prettier --check \"./**/*.{ts,tsx,js,json,md}\"",
    "type-check": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:cov": "npm run test:unit:cov && npm run test:integration:cov && npm run test:e2e:cov",
    "test:cov:merge": "node scripts/merge-coverage.js",
    "test:cov:all": "npm run test:unit:cov && npm run test:integration:cov && npm run test:e2e:cov && npm run test:cov:merge",
    "test:watch": "jest --watch --detectOpenHandles",
    "test:unit": "jest --config ./jest-unit.json  --detectOpenHandles --forceExit",
    "test:unit:watch": "jest --config ./jest-unit.json --watch --detectOpenHandles",
    "test:unit:cov": "jest --config ./jest-unit.json --coverage --coverageDirectory=coverage/unit",
    "test:unit:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --config ./jest-unit.json --runInBand",
    "test:integration": "jest --config ./jest-integration.json --detectOpenHandles --forceExit",
    "test:integration:watch": "jest --config ./jest-integration.json --watch --detectOpenHandles",
    "test:integration:cov": "jest --config ./jest-integration.json --coverage --coverageDirectory=coverage/integration",
    "test:integration:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --config ./jest-integration.json --runInBand",
    "test:e2e": "jest --config ./jest-e2e.json --detectOpenHandles --runInBand",
    "test:e2e:watch": "jest --config ./jest-e2e.json --watch --detectOpenHandles --runInBand",
    "test:e2e:cov": "jest --config ./jest-e2e.json --coverage --coverageDirectory=coverage/e2e",
    "test:e2e:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --config ./jest-e2e.json --runInBand",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:ci": "jest --ci --coverage --watchAll=false --detectOpenHandles --forceExit",
    "prepare": "husky",
    "postinstall": "patch-package",
    "clean": "rimraf dist coverage .nyc_output",
    "deps:check": "ncu --doctor",
    "deps:update": "ncu -u",
    "security:audit": "yarn audit --audit-level moderate",
    "docker:build": "docker build -t contact-list .",
    "docker:run": "docker run -p 3000:3000 contact-list"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.864.0",
    "@json2csv/plainjs": "^7.0.6",
    "@nestjs-modules/mailer": "^2.0.2",
    "@nestjs/cache-manager": "^3.0.1",
    "@nestjs/common": "10.4.19",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "10.4.19",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/mapped-types": "2.0.4",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^10.4.20",
    "@nestjs/swagger": "^7.4.0",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/typeorm": "^10.0.2",
    "@types/compression": "^1.8.1",
    "@types/helmet": "^4.0.0",
    "bcryptjs": "^3.0.2",
    "cache-manager": "^7.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.8.1",
    "dotenv": "^16.6.1",
    "helmet": "^8.1.0",
    "multer-s3": "^3.0.1",
    "nest-csv-parser": "^2.0.4",
    "nodemailer": "^7.0.5",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "patch-package": "^8.0.0",
    "pg": "^8.11.5",
    "reflect-metadata": "0.1.14",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.20",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@istanbuljs/nyc-config-typescript": "^1.0.2",
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^10.2.2",
    "@nestjs/testing": "10.4.19",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.23",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.14.10",
    "@types/nodemailer": "^6.4.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^7.13.1",
    "@typescript-eslint/parser": "^7.13.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.2.1",
    "husky": "^9.1.7",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-merge": "^2.0.0",
    "istanbul-reports": "^3.1.7",
    "jest": "^29.7.0",
    "jsonwebtoken": "^9.0.2",
    "lint-staged": "^16.1.5",
    "prettier": "^3.3.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.4",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
