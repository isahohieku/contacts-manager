{
  "name": "contact-list",
  "version": "0.0.1",
  "description": "Simple contact management app",
  "author": "Isah Ohieku",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "pretypeorm": "ts-node -r tsconfig-paths/register ./src/database/scripts/typeorm-config.ts",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d ./src/database/data-source.ts",
    "seeds": "ts-node -r tsconfig-paths/register ./node_modules/typeorm-seeding/dist/cli.js",
    "migration:generate": "yarn run typeorm migration:generate",
    "migration:create": "yarn run typeorm migration:create -n",
    "migration:run": "yarn run typeorm migration:run",
    "migration:revert": "yarn run typeorm migration:revert",
    "schema:drop": "yarn run typeorm schema:drop",
    "seed:config": "yarn run seeds config",
    "seed:run": "yarn run seeds seed",
    "prebuild": "rm -rf dist",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "lint": "eslint \"{src,test}/**/*.ts\" --ext .tsx,.ts --max-warnings 0",
    "lint:fix": "yarn run lint --fix",
    "prettier": "prettier \"./**/*.{ts,tsx}\"",
    "prettier:fix": "yarn run prettier --write",
    "prettier:check": "yarn run prettier --check",
    "test": "jest --detectOpenHandles --forceExit --maxWorkers=50%",
    "test:unit": "jest --config ./jest-unit.json --detectOpenHandles --forceExit --maxWorkers=50%",
    "test:unit:watch": "jest --config ./jest-unit.json --watch --detectOpenHandles --forceExit --maxWorkers=50%",
    "test:unit:cov": "jest --config ./jest-unit.json --coverage",
    "test:unit:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --config ./jest-unit.json --runInBand",
    "test:integration": "jest --config ./jest-integration.json --detectOpenHandles --forceExit --maxWorkers=50%",
    "test:integration:watch": "jest --config ./jest-integration.json --watch --detectOpenHandles --forceExit --maxWorkers=50%",
    "test:integration:cov": "jest --config ./jest-integration.json --coverage",
    "test:integration:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --config ./jest-integration.json --runInBand",
    "test:watch": "jest --watch --detectOpenHandles --forceExit --maxWorkers=50%",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand --maxWorkers=1",
    "test:e2e": "jest --config ./jest-e2e.json --detectOpenHandles --runInBand --maxWorkers=1",
    "test:e2e:cov": "jest --config ./jest-e2e.json --coverage",
    "test:e2e:watch": "jest --config ./jest-e2e.json --watch --detectOpenHandles --forceExit --runInBand --maxWorkers=1",
    "test:e2e:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --config ./jest-e2e.json --runInBand",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.665.0",
    "@json2csv/plainjs": "^7.0.6",
    "@nestjs-modules/mailer": "^2.0.2",
    "@nestjs/cache-manager": "^3.0.1",
    "@nestjs/common": "^10.4.16",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.16",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/mapped-types": "*",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.16",
    "@nestjs/serve-static": "^4.0.2",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/throttler": "^6.2.1",
    "@nestjs/typeorm": "^10.0.2",
    "@types/uuid": "^10.0.0",
    "bcryptjs": "^2.4.3",
    "cache-manager": "^7.0.1",
    "cache-manager-redis-store": "^3.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.7.4",
    "handlebars": "^4.7.8",
    "helmet": "^8.0.0",
    "libphonenumber-js": "^1.11.10",
    "multer": "^2.0.1",
    "multer-s3": "^3.0.1",
    "nest-csv-parser": "^2.0.4",
    "nodemailer": "^6.9.15",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.13.0",
    "redis": "^5.5.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20",
    "typeorm-seeding": "^1.6.1",
    "uuid": "^11.1.0",
    "winston": "^3.15.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.1.4",
    "@nestjs/testing": "^10.4.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/cache-manager": "^5.0.0",
    "@types/cache-manager-redis-store": "^3.0.0",
    "@types/compression": "^1.7.5",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.13",
    "@types/lodash": "^4.17.20",
    "@types/multer": "^2.0.0",
    "@types/multer-s3": "^3.0.3",
    "@types/node": "^22.7.4",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.2.1",
    "husky": "^9.1.6",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.2"
  },
  "resolutions": {
    "jackspeak": "2.1.1"
  },
  "jest": {
    "projects": [
      {
        "displayName": "unit",
        "testMatch": [
          "<rootDir>/src/**/*.spec.ts"
        ],
        "testPathIgnorePatterns": [
          ".*\\.integration\\.spec\\.ts$"
        ],
        "moduleFileExtensions": [
          "js",
          "json",
          "ts"
        ],
        "rootDir": ".",
        "transform": {
          "^.+\\.(t|j)s$": "ts-jest"
        },
        "testEnvironment": "node",
        "moduleNameMapper": {
          "^@contactApp/(.*)$": "<rootDir>/src/$1"
        },
        "setupFilesAfterEnv": [
          "<rootDir>/test/setup.ts"
        ],
        "collectCoverageFrom": [
          "src/**/*.ts",
          "!src/**/*.integration.spec.ts",
          "!src/**/*.e2e-spec.ts",
          "!src/main.ts",
          "!src/**/*.module.ts",
          "!src/database/migrations/**",
          "!src/database/seeds/**"
        ]
      },
      {
        "displayName": "integration",
        "testMatch": [
          "<rootDir>/src/**/*.integration.spec.ts",
          "<rootDir>/test/**/*.integration.spec.ts"
        ],
        "moduleFileExtensions": [
          "js",
          "json",
          "ts"
        ],
        "rootDir": ".",
        "transform": {
          "^.+\\.(t|j)s$": "ts-jest"
        },
        "testEnvironment": "node",
        "moduleNameMapper": {
          "^@contactApp/(.*)$": "<rootDir>/src/$1"
        },
        "setupFilesAfterEnv": [
          "<rootDir>/test/setup.ts"
        ],
        "collectCoverageFrom": [
          "src/**/*.ts",
          "!src/**/*.spec.ts",
          "!src/**/*.e2e-spec.ts",
          "!src/main.ts",
          "!src/**/*.module.ts",
          "!src/database/migrations/**",
          "!src/database/seeds/**"
        ]
      },
      {
        "displayName": "e2e",
        "testMatch": [
          "<rootDir>/test/**/*.e2e-spec.ts"
        ],
        "moduleFileExtensions": [
          "js",
          "json",
          "ts"
        ],
        "rootDir": ".",
        "transform": {
          "^.+\\.(t|j)s$": "ts-jest"
        },
        "testEnvironment": "node",
        "moduleNameMapper": {
          "^@contactApp/(.*)$": "<rootDir>/src/$1"
        },
        "collectCoverageFrom": [
          "src/**/*.ts",
          "!src/**/*.spec.ts",
          "!src/**/*.integration.spec.ts",
          "!src/main.ts",
          "!src/**/*.module.ts",
          "!src/database/migrations/**",
          "!src/database/seeds/**"
        ]
      }
    ],
    "collectCoverageFrom": [
      "src/**/*.(t|j)s",
      "!src/**/*.spec.ts",
      "!src/**/*.e2e-spec.ts",
      "!src/main.ts",
      "!src/database/migrations/**",
      "!src/database/seeds/**"
    ],
    "coverageDirectory": "./coverage"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
